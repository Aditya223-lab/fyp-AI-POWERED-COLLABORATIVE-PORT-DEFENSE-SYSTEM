# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32   (or any 32+ char random string)
NEXTAUTH_SECRET=replace-me-with-32-char-random-string

# --- Spring Boot backend (REST + SSE) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_SSE_URL=http://localhost:8080/api/events/threats

# --- Shared HS256 secret with the Spring backend (app.jwt.secret in application.properties).
# Generate with:  openssl rand -base64 48   (must be 32+ characters)
APP_JWT_SECRET=replace-me-with-32-char-random-string

# --- Admin allowlist (comma-separated emails) ---
ADMIN_EMAILS=paudel.asal00@gmail.com

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (https://github.com/settings/developers -> New OAuth App) ---
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- eSewa ePay v2 (https://developer.esewa.com.np/pages/Epay) ---
# Defaults (when left blank) are eSewa's public UAT sandbox: product code
# EPAYTEST + published test secret. Test wallet: id 9806800001-5,
# password Nepal@123, MPIN 1122, OTP 123456. For production set your real
# merchant product code + secret and the epay.esewa.com.np URLs.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=
ESEWA_STATUS_URL=
# Premium price in NPR (server-side; the client can never change it)
PREMIUM_PRICE_NPR=999
NEXT_PUBLIC_APP_URL=http://localhost:3000
