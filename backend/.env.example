# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored — never commit real keys.
#
# The app reads it via spring.config.import in application.properties, so the
# values apply however you start the backend (IntelliJ, mvnw, terminal).

# VirusTotal API key for the /scan page.
# Free key: virustotal.com -> sign up -> avatar menu -> API key
VIRUSTOTAL_API_KEY=

# Gmail app password, if you want alert/contact emails to actually send.
# MAIL_PASSWORD=

# Must match APP_JWT_SECRET in frontend/client/.env.local (32+ chars).
# APP_JWT_SECRET=
